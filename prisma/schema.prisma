generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // اتصال مباشر (بدون pooler) لأوامر الهجرة على Supabase؛ اختياري محليًا
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String    @db.VarChar(255)
  city                       String?   @db.VarChar(100)
  subdomain                  String?   @unique @db.VarChar(100)
  customDomain               String?   @map("custom_domain") @db.VarChar(255)
  defaultLanguage            String?   @default("ar") @map("default_language") @db.VarChar(10)
  timezone                   String?   @default("Asia/Bahrain") @db.VarChar(50)
  currency                   String?   @default("BHD") @db.VarChar(10)
  latitude                   Decimal?  @db.Decimal(10, 8)
  longitude                  Decimal?  @db.Decimal(11, 8)
  addressText                String?   @map("address_text")
  bookingPolicy              String?   @default("DEPOSIT_REQUIRED") @map("booking_policy") @db.VarChar(50)
  workingHoursText           String?   @map("working_hours_text")
  workingHours               Json?     @map("working_hours") @db.JsonB
  description                Json?     @db.JsonB
  phone                      String?   @db.VarChar(50)
  isPublished                Boolean   @default(true) @map("is_published")
  // إخفاء/حظر من الإدارة: يتفوق على isPublished ولا يملك المالك تغييره
  adminHiddenAt              DateTime? @map("admin_hidden_at") @db.Timestamp(6)
  // مهام تلقائية أوقفها الأدمن لهذا الصالون: reports | reminders | reviews (المصفوفة الفارغة = الكل يعمل)
  automationOff              String[]  @default([]) @map("automation_off")
  depositPercentage          Int       @default(30) @map("deposit_percentage")
  minBookingNoticeHours      Int       @default(2) @map("min_booking_notice_hours")
  cancellationHours          Int       @default(24) @map("cancellation_hours")
  refundPercentAfterDeadline Int       @default(0) @map("refund_percent_after_deadline")
  logoUrl                    String?   @map("logo_url")
  logoPath                   String?   @map("logo_path")
  isFeatured                 Boolean   @default(false) @map("is_featured")
  plan                       String    @default("TRIAL") @db.VarChar(20)
  trialEndsAt                DateTime? @map("trial_ends_at") @db.Timestamp(6)
  createdAt                  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                  DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  owner            Owner?
  staff            Staff[]
  customers        Customer[]
  services         Service[]
  appointments     Appointment[]
  customerPackages CustomerPackage[]
  offers           Offer[]
  reviews          Review[]
  favorites        Favorite[]
  photos           SalonPhoto[]
  conversations    Conversation[]
  whatsappAccount  WhatsappAccount?
  reportSchedules  ReportSchedule[]
  contacts         Contact[]

  @@map("tenants")
}

model Offer {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  type               String    @db.VarChar(30)
  discountPercent    Int?      @map("discount_percent")
  discountAmount     Decimal?  @map("discount_amount") @db.Decimal(10, 2)
  appliesToServiceId String?   @map("applies_to_service_id") @db.Uuid
  freeServiceId      String?   @map("free_service_id") @db.Uuid
  endsAt             DateTime? @map("ends_at") @db.Timestamp(6)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appliesToService Service?      @relation("OfferAppliesTo", fields: [appliesToServiceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  freeService      Service?      @relation("OfferFreeService", fields: [freeServiceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  appointments     Appointment[]

  @@map("offers")
}

model Owner {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @unique @map("tenant_id") @db.Uuid
  name              String    @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamp(6)
  suspendedAt       DateTime? @map("suspended_at") @db.Timestamp(6)
  // أي جلسة صدرت قبل هذا الوقت تُرفض — تغيير/استعادة كلمة المرور يطرد الأجهزة الأخرى
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamp(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("owners")
}

// رموز لمرة واحدة (استعادة كلمة المرور / تأكيد البريد) — نخزن hash الرمز فقط
model AuthToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose   String    @db.VarChar(30)
  audience  String    @db.VarChar(20)
  subjectId String    @map("subject_id") @db.Uuid
  email     String    @db.VarChar(255)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([subjectId, purpose])
  @@map("auth_tokens")
}

// حساب مالك المنصة — منفصل تمامًا عن Owner (لا يتبع لأي Tenant)
model Admin {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String    @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("admins")
}

model Staff {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String   @db.VarChar(255)
  role         String?  @db.VarChar(100)
  phone        String?  @db.VarChar(50)
  status       String   @default("ACTIVE") @db.VarChar(50)
  workingHours Json?    @map("working_hours") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointments Appointment[]

  @@map("staff")
}

model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  accountId String?  @map("account_id") @db.Uuid
  name      String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account          CustomerAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  appointments     Appointment[]
  customerPackages CustomerPackage[]
  contacts         Contact[]

  @@map("customers")
}

// حساب دخول العميل — عابر للصالونات، منفصل عن Customer (سجل CRM خاص بكل
// صالون على حدة). شخص واحد يقدر يكون له أكثر من سجل Customer (وحد بكل
// صالون حجز فيه)، كلها مرتبطة بنفس CustomerAccount عبر accountId.
model CustomerAccount {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String    @db.VarChar(255)
  email                String    @unique @db.VarChar(255)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt      DateTime? @map("email_verified_at") @db.Timestamp(6)
  suspendedAt          DateTime? @map("suspended_at") @db.Timestamp(6)
  passwordChangedAt    DateTime? @map("password_changed_at") @db.Timestamp(6)
  points               Int       @default(0)
  // كود إحالة قصير قابل للمشاركة (رابط تسجيل صديق)، فريد لكل حساب
  referralCode         String    @unique @map("referral_code") @db.VarChar(16)
  referredByAccountId  String?   @map("referred_by_account_id") @db.Uuid
  // آخر رسالة "اشتقنا لك" أُرسلت للحساب — تمنع تكرارها قبل مرور المدة
  lastMarketingEmailAt DateTime? @map("last_marketing_email_at") @db.Timestamp(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  // العلاقة الذاتية: من دعا هذا الحساب، ومن دعاهم هذا الحساب
  referredBy CustomerAccount?  @relation("Referrals", fields: [referredByAccountId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  referrals  CustomerAccount[] @relation("Referrals")

  customers     Customer[]
  reviews       Review[]
  favorites     Favorite[]
  conversations Conversation[]

  @@map("customer_accounts")
}

model Service {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String?   @map("tenant_id") @db.Uuid
  name                Json?     @db.JsonB
  description         Json?     @db.JsonB
  basePrice           Decimal?  @map("base_price") @db.Decimal(10, 2)
  baseDurationMinutes Int?      @map("base_duration_minutes")
  pricingModel        String?   @map("pricing_model") @db.VarChar(50)
  visibilitySetting   String?   @map("visibility_setting") @db.VarChar(50)
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  tenant           Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  options          ServiceOption[]
  pricingRules     ServicePricingRule[]
  appointments     Appointment[]
  customerPackages CustomerPackage[]
  offersAppliesTo  Offer[]              @relation("OfferAppliesTo")
  offersFree       Offer[]              @relation("OfferFreeService")

  @@map("services")
}

model ServiceOption {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId  String?   @map("service_id") @db.Uuid
  optionName Json?     @map("option_name") @db.JsonB
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("service_options")
}

model ServicePricingRule {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId              String?  @map("service_id") @db.Uuid
  optionValue            String?  @map("option_value") @db.VarChar(100)
  additionalPrice        Decimal? @map("additional_price") @db.Decimal(10, 2)
  additionalDurationMins Int?     @map("additional_duration_minutes")
  bufferTimeMins         Int?     @default(15) @map("buffer_time_minutes")

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("service_pricing_rules")
}

model Appointment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  employeeId     String?   @map("employee_id") @db.Uuid
  serviceId      String?   @map("service_id") @db.Uuid
  appliedOfferId String?   @map("applied_offer_id") @db.Uuid
  status         String?   @db.VarChar(50)
  totalAmount    Decimal?  @map("total_amount") @db.Decimal(10, 2)
  depositAmount  Decimal?  @map("deposit_amount") @db.Decimal(10, 2)
  paymentStatus  String?   @map("payment_status") @db.VarChar(50)
  startTime      DateTime? @map("start_time") @db.Timestamp(6)
  endTime        DateTime? @map("end_time") @db.Timestamp(6)
  holdExpiresAt  DateTime? @map("hold_expires_at") @db.Timestamp(6)
  // أُرسل تذكير الموعد (بريد قبل ~24 ساعة) — يمنع التكرار
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamp(6)

  review       Review?
  appliedOffer Offer?    @relation(fields: [appliedOfferId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service      Service?  @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  employee     Staff?    @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("appointments")
}

model CustomerPackage {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String?   @map("tenant_id") @db.Uuid
  customerId        String?   @map("customer_id") @db.Uuid
  serviceId         String?   @map("service_id") @db.Uuid
  packageName       Json?     @map("package_name") @db.JsonB
  price             Decimal?  @db.Decimal(10, 2)
  status            String?   @default("ACTIVE") @db.VarChar(50)
  totalSessions     Int?      @map("total_sessions")
  remainingSessions Int?      @map("remaining_sessions")
  expiresAt         DateTime? @map("expires_at") @db.Date
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("customer_packages")
}

// تقييم صالون بعد موعد مكتمل — تقييم واحد لكل موعد
model Review {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  rating        Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account     CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointment Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("reviews")
}

model Favorite {
  accountId String   @map("account_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([accountId, tenantId])
  @@map("favorites")
}

// محادثة بين عميل وصالون — سجل واحد لكل زوج (صالون، عميل)، فيملك الصالون
// محادثات مستقلة متعددة في آن واحد، واحدة لكل عميل يراسله
model Conversation {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  // محادثة ويب قديمة (حساب عميل) أو محادثة واتساب (جهة اتصال) — واحد منهما فقط
  accountId            String?   @map("account_id") @db.Uuid
  contactId            String?   @map("contact_id") @db.Uuid
  // آخر رسالة واردة من العميل: تحدد نافذة الرد الحر على واتساب (24 ساعة)
  lastInboundAt        DateTime? @map("last_inbound_at") @db.Timestamp(6)
  // من يرد الآن: HUMAN (المالك) | AGENT (الوكيل) | ESCALATED (الوكيل صعّد للمالك)
  mode                 String    @default("HUMAN") @db.VarChar(20)
  lastMessageAt        DateTime  @default(now()) @map("last_message_at") @db.Timestamp(6)
  lastReadByOwnerAt    DateTime? @map("last_read_by_owner_at") @db.Timestamp(6)
  lastReadByCustomerAt DateTime? @map("last_read_by_customer_at") @db.Timestamp(6)
  // حظر العميل لهذا الصالون: لا يستطيع المالك إرسال رسائل جديدة ولا يصله بريد
  blockedByCustomerAt  DateTime? @map("blocked_by_customer_at") @db.Timestamp(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account  CustomerAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact  Contact?         @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages Message[]

  @@unique([tenantId, accountId])
  @@unique([tenantId, contactId])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  // منسوخ من المحادثة عند الإنشاء — يمنح هذا الجدول نفس عزل RLS القائم على
  // tenant_id الذي تحصل عليه بقية جداول المستأجر تلقائيًا (راجع scripts/rls-setup.mjs)
  tenantId       String   @map("tenant_id") @db.Uuid
  senderRole     String   @map("sender_role") @db.VarChar(20)
  body           String
  // واتساب: معرّف الرسالة لدى Meta (فريد: يمنع تكرار المعالجة عند إعادة الإرسال)
  waMessageId    String?  @unique @map("wa_message_id") @db.VarChar(128)
  direction      String?  @db.VarChar(10)
  msgType        String   @default("text") @map("msg_type") @db.VarChar(20)
  mediaId        String?  @map("media_id") @db.VarChar(255)
  // حالة التسليم للرسائل الصادرة: sent | delivered | read | failed
  status         String?  @db.VarChar(20)
  error          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// رقم واتساب مربوط بصالون (واجهة Meta الرسمية). صالون واحد = رقم واحد حاليًا.
// الرمز مشفّر AES-GCM؛ إن غاب يُستعمل رمز النظام من المتغيرات (رقم الاختبار).
model WhatsappAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  phoneNumberId  String   @unique @map("phone_number_id") @db.VarChar(64)
  wabaId         String?  @map("waba_id") @db.VarChar(64)
  displayPhone   String?  @map("display_phone") @db.VarChar(32)
  status         String   @default("ACTIVE") @db.VarChar(20)
  accessTokenEnc String?  @map("access_token_enc")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("whatsapp_accounts")
}

// جهة اتصال = عميل واتساب (هويته رقمه، بلا حساب). تُربط بسجل CRM للصالون.
model Contact {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  phone         String    @db.VarChar(32)
  name          String?   @db.VarChar(255)
  customerId    String?   @map("customer_id") @db.Uuid
  lastInboundAt DateTime? @map("last_inbound_at") @db.Timestamp(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  conversations Conversation[]

  @@unique([tenantId, phone])
  @@map("contacts")
}

// جدولة تقارير دورية بالبريد. scope=OWNER: tenantId للصالون والبريد هو بريد المالك الحالي؛
// scope=ADMIN: tenantId فارغ وadminId هو المشرف والبريد بريده الحالي. لا يُخزَّن بريد
// حر (يمنع استعمال المنصة لإرسال تقارير لطرف ثالث).
model ReportSchedule {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope      String    @db.VarChar(10)
  tenantId   String?   @map("tenant_id") @db.Uuid
  adminId    String?   @map("admin_id") @db.Uuid
  reportType String    @map("report_type") @db.VarChar(30)
  frequency  String    @db.VarChar(10)
  dayOfWeek  Int?      @map("day_of_week")
  dayOfMonth Int?      @map("day_of_month")
  locale     String    @default("ar") @db.VarChar(5)
  isActive   Boolean   @default(true) @map("is_active")
  lastRunAt  DateTime? @map("last_run_at") @db.Timestamp(6)
  lastError  String?   @map("last_error")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([isActive, scope])
  @@map("report_schedules")
}

// سجل تدقيق لإجراءات الأدمن الحساسة. لا FK على الهدف حتى يبقى السجل بعد حذفه.
model AdminAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId     String?  @map("admin_id") @db.Uuid
  adminEmail  String   @map("admin_email") @db.VarChar(255)
  action      String   @db.VarChar(50)
  targetType  String   @map("target_type") @db.VarChar(30)
  targetId    String?  @map("target_id") @db.Uuid
  targetLabel String?  @map("target_label") @db.VarChar(255)
  details     Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

// إعدادات المنصة القابلة للتعديل من الأدمن (أسعار الباقات، مدة التجربة، إعلان للملاك)
model PlatformSetting {
  key       String   @id @db.VarChar(50)
  value     Json     @db.JsonB
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("platform_settings")
}

// معرض صور الصالون (متعدد) — منفصل عن الشعار الواحد (Tenant.logoUrl)
model SalonPhoto {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  url         String
  storagePath String   @map("storage_path")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, sortOrder])
  @@map("salon_photos")
}

// سجل موافقة كل صالون على نسخة اتفاقية الصالون (PRD §7.5). بلا FK عن قصد: يبقى
// كدليل قانوني حتى لو حُذف الصالون لاحقًا.
model TenantAgreement {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  agreementVersion String   @map("agreement_version") @db.VarChar(20)
  acceptedAt       DateTime @default(now()) @map("accepted_at") @db.Timestamp(6)
  acceptedByUserId String?  @map("accepted_by_user_id") @db.Uuid
  ipAddress        String?  @map("ip_address") @db.VarChar(50)

  @@index([tenantId, agreementVersion])
  @@map("tenant_agreements")
}

// سجل موافقات حماية البيانات للعملاء (PDPL/GDPR — PRD §7.1). آخر سطر لكل نوع هو
// الحالة الفعلية؛ الأسطر السابقة تبقى كتاريخ. بلا FK لنفس سبب الجدول أعلاه.
model ConsentLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  consentType String   @map("consent_type") @db.VarChar(50)
  granted     Boolean
  version     String?  @db.VarChar(20)
  ipAddress   String?  @map("ip_address") @db.VarChar(50)
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamp(6)

  @@index([accountId, consentType, recordedAt(sort: Desc)])
  @@map("consent_logs")
}
